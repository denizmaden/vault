logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "vault" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

discovery.relabel "vault" {
  targets = discovery.docker.vault.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/vault-.+"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    target_label = "job"
    replacement  = "vault-docker"
  }
}

loki.source.docker "vault" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.vault.output
  labels           = { source = "docker" }
  refresh_interval = "10s"
  forward_to       = [loki.process.vault.receiver]
}

loki.process "vault" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = {
      level          = "Level",
      service        = "Properties.service",
      environment    = "Properties.environment",
      trace_id       = "Properties.trace_id",
      span_id        = "Properties.span_id",
      correlation_id = "Properties.correlation_id",
    }
  }

  stage.labels {
    values = {
      level       = "level",
      service     = "service",
      environment = "environment",
    }
  }

  stage.structured_metadata {
    values = {
      trace_id       = "trace_id",
      span_id        = "span_id",
      correlation_id = "correlation_id",
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
