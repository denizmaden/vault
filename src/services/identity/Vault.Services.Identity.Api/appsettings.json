{
  "IdentityServer": {
    "SwaggerClientId": "",
    "SwaggerClientSecret": "",
    "IssuerUri": null,
    "AccessTokenLifetimeSeconds": 3600,
    "AbsoluteRefreshTokenLifetimeSeconds": 2592000,
    "SlidingRefreshTokenLifetimeSeconds": 1296000
  },
  "Observability": {
    "Logging": {
      "Provider": "Serilog"
    },
    "Tracing": {
      "Enabled": true
    },
    "Metrics": {
      "Enabled": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
