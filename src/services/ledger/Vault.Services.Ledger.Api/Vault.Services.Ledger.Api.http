@identityHost = http://localhost:8080
@ledgerHost = http://localhost:8082
@email = ledger@example.com
@password = Ledger123!
@ownerId = 11111111-1111-1111-1111-111111111111
@ledgerAccountId = 33333333-3333-3333-3333-333333333333
@accessToken = paste-access-token-here

### Service information
GET {{ledgerHost}}/
Accept: application/json

### Liveness check
GET {{ledgerHost}}/health/live
Accept: application/json

### Readiness check (SQL Server and messaging provider)
GET {{ledgerHost}}/health/ready
Accept: application/json

### Register an Identity user
POST {{identityHost}}/api/identity-users
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Get a Ledger access token, then copy access_token above
POST {{identityHost}}/connect/token
Content-Type: application/x-www-form-urlencoded

client_id=vault-swagger&client_secret=vault-swagger-secret&grant_type=password&username={{email}}&password={{password}}&scope=vault.ledger.api

### Open account
POST {{ledgerHost}}/api/ledger-accounts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "ledgerAccountId": "{{ledgerAccountId}}",
  "ownerId": "{{ownerId}}",
  "currency": "TRY"
}

### Deposit funds
POST {{ledgerHost}}/api/ledger-accounts/{{ledgerAccountId}}/deposit
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "amount": 250.50,
  "reference": "initial-deposit"
}

### Withdraw funds
POST {{ledgerHost}}/api/ledger-accounts/{{ledgerAccountId}}/withdraw
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "amount": 50.25,
  "reference": "test-withdrawal"
}

### Get account
GET {{ledgerHost}}/api/ledger-accounts/{{ledgerAccountId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get event stream
GET {{ledgerHost}}/api/ledger-accounts/{{ledgerAccountId}}/events
Authorization: Bearer {{accessToken}}
Accept: application/json
