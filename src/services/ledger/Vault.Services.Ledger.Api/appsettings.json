{
  "ConnectionStrings": {
    "LedgerDatabase": "Server=localhost,14335;Database=VaultLedger;User Id=sa;Password=Your_strong_password123;TrustServerCertificate=True"
  },
  "Authentication": {
    "Authority": "http://localhost:8080",
    "MetadataAddress": "http://localhost:8080/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Messaging": {
    "Provider": "Kafka",
    "Kafka": {
      "BootstrapServers": "localhost:29092"
    }
  },
  "LedgerMessaging": {
    "EventsDestination": "vault.ledger.events"
  },
  "Observability": {
    "Logging": {
      "Provider": "Serilog"
    },
    "Tracing": {
      "Enabled": true
    },
    "Metrics": {
      "Enabled": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
