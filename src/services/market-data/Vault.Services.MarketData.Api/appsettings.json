{
  "Authentication": {
    "Authority": "http://localhost:8080",
    "MetadataAddress": "http://localhost:8080/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Messaging": {
    "Provider": "Kafka",
    "Kafka": {
      "BootstrapServers": "localhost:29092"
    }
  },
  "MarketDataMessaging": {
    "PricesDestination": "vault.market-data.prices",
    "DeadLetterDestination": "vault.market-data.prices.dlq",
    "ProjectionConsumerGroupId": "vault-market-data-projection",
    "MaxProcessingAttempts": 5,
    "RetryInitialDelayMilliseconds": 200,
    "DeadLetterPublishRetrySeconds": 2,
    "RebuildSnapshotWhenEmpty": true,
    "RebuildTimeoutSeconds": 60
  },
  "MarketDataRedis": {
    "ConnectionString": "localhost:6381,abortConnect=false",
    "SnapshotHashKey": "vault:market-data:{prices:v1}:values",
    "SnapshotTimestampHashKey": "vault:market-data:{prices:v1}:timestamps",
    "RealtimeChannel": "vault:market-data:realtime:v1"
  },
  "MarketDataIngestion": {
    "Enabled": true
  },
  "MarketDataWebSockets": {
    "MaxConnections": 5000,
    "MaxConnectionsPerClient": 5,
    "OutboundQueueCapacity": 256,
    "MaxIncomingMessageBytes": 16384,
    "CommandsPerMinute": 120
  },
  "MarketDataSecurity": {
    "RequireAuthentication": false,
    "AllowConnectionsWithoutOrigin": true,
    "AllowedOrigins": [
      "http://localhost:8086"
    ],
    "RestRequestsPerMinute": 120,
    "WebSocketHandshakesPerMinute": 20
  },
  "Finnhub": {
    "Enabled": true,
    "ApiKey": "",
    "WebSocketUrl": "wss://ws.finnhub.io",
    "ReconnectDelaySeconds": 5,
    "Instruments": [
      {
        "ProviderSymbol": "OANDA:USD_TRY",
        "Symbol": "USD-TRY",
        "DisplayName": "US Dollar",
        "BaseAsset": "USD",
        "QuoteAsset": "TRY"
      },
      {
        "ProviderSymbol": "OANDA:EUR_TRY",
        "Symbol": "EUR-TRY",
        "DisplayName": "Euro",
        "BaseAsset": "EUR",
        "QuoteAsset": "TRY"
      }
    ]
  },
  "Binance": {
    "Enabled": true,
    "WebSocketUrl": "wss://stream.binance.com:9443/stream",
    "ReconnectDelaySeconds": 5,
    "Instruments": [
      {
        "Stream": "btcusdt@ticker",
        "ProviderSymbol": "BTCUSDT",
        "Symbol": "BTC-USDT",
        "DisplayName": "Bitcoin",
        "BaseAsset": "BTC",
        "QuoteAsset": "USDT"
      },
      {
        "Stream": "ethusdt@ticker",
        "ProviderSymbol": "ETHUSDT",
        "Symbol": "ETH-USDT",
        "DisplayName": "Ethereum",
        "BaseAsset": "ETH",
        "QuoteAsset": "USDT"
      }
    ]
  },
  "Observability": {
    "Logging": {
      "Provider": "Serilog"
    },
    "Tracing": {
      "Enabled": true
    },
    "Metrics": {
      "Enabled": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
