{
  "Authentication": {
    "Authority": "http://localhost:8080",
    "MetadataAddress": "http://localhost:8080/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27019",
    "DatabaseName": "vault-reporting",
    "ReportsCollectionName": "wallet_activity_reports"
  },
  "Messaging": {
    "Provider": "Kafka",
    "Kafka": {
      "BootstrapServers": "localhost:29092"
    }
  },
  "ReportingMessaging": {
    "LedgerEventsDestination": "vault.ledger.events",
    "ConsumerGroupId": "vault-reporting-projection"
  },
  "Observability": {
    "Logging": {
      "Provider": "Serilog"
    },
    "Tracing": {
      "Enabled": true
    },
    "Metrics": {
      "Enabled": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
