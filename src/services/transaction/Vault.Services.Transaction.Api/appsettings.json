{
  "ConnectionStrings": {
    "TransactionDatabase": "Server=localhost,14336;Database=VaultTransaction;User Id=sa;Password=Your_strong_password123;TrustServerCertificate=True"
  },
  "Authentication": {
    "Authority": "http://localhost:8080",
    "MetadataAddress": "http://localhost:8080/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Messaging": {
    "Provider": "RabbitMQ",
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "VirtualHost": "/"
    }
  },
  "TransactionMessaging": {
    "RequestedQueue": "vault.transaction.transfer.requested",
    "ReservedQueue": "vault.transaction.transfer.funds-reserved",
    "CompletedQueue": "vault.transaction.transfer.completed",
    "FailedQueue": "vault.transaction.transfer.failed"
  },
  "Observability": {
    "Logging": {
      "Provider": "Serilog"
    },
    "Tracing": {
      "Enabled": true
    },
    "Metrics": {
      "Enabled": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
