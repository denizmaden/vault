{
  "Authentication": {
    "Authority": "http://localhost:8080",
    "MetadataAddress": "http://localhost:8080/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27018",
    "DatabaseName": "vault-wallet",
    "WalletsCollectionName": "wallets"
  },
  "Messaging": {
    "Provider": "Kafka",
    "Kafka": {
      "BootstrapServers": "localhost:29092"
    }
  },
  "WalletMessaging": {
    "LedgerEventsDestination": "vault.ledger.events",
    "ConsumerGroupId": "vault-wallet-projection"
  },
  "Caching": {
    "Enabled": true,
    "Provider": "Redis",
    "Redis": {
      "ConnectionString": "localhost:6380",
      "InstanceName": "vault-wallet:"
    }
  },
  "WalletCache": {
    "WalletDetailsTtlSeconds": 300
  },
  "Observability": {
    "Logging": {
      "Provider": "Serilog"
    },
    "Tracing": {
      "Enabled": true
    },
    "Metrics": {
      "Enabled": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
