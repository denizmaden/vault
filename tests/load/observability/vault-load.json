{
  "uid": "vault-load",
  "title": "Vault - Load Test",
  "schemaVersion": 39,
  "version": 3,
  "tags": [
    "vault",
    "k6"
  ],
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(k6_http_reqs_total, run_id)",
        "refresh": 1,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(k6_http_reqs_total{run_id=\"$run_id\",phase=\"measure\"}[1m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p95 seconds by service",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "max by (service) (k6_http_req_duration_p95{run_id=\"$run_id\",phase=\"measure\"})",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP failure ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (service) (k6_http_req_failed_rate{run_id=\"$run_id\",phase=\"measure\"})",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Projection / saga p95 seconds",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "k6_projection_latency_ms_p95{run_id=\"$run_id\"}",
          "legendFormat": "Kafka projection"
        },
        {
          "expr": "k6_saga_latency_ms_p95{run_id=\"$run_id\"}",
          "legendFormat": "RabbitMQ saga"
        }
      ]
    },
    {
      "id": 6,
      "title": "Correctness failures",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(k6_correctness_failures_total{run_id=\"$run_id\"})",
          "legendFormat": "correctness"
        }
      ]
    },
    {
      "id": 7,
      "title": "Completed business workflows / minute",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "60 * sum by (workflow) (rate(k6_workflows_completed_total{run_id=\"$run_id\",phase=\"measure\"}[1m]))",
          "legendFormat": "{{workflow}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 8,
      "title": "Business workflow p95 seconds",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "max by (workflow) (k6_workflow_duration_ms_p95{run_id=\"$run_id\",phase=\"measure\"})",
          "legendFormat": "{{workflow}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 9,
      "title": "Successful HTTP endpoint samples (2xx only)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum by (endpoint) (k6_endpoint_successes_total{run_id=\"$run_id\",phase=\"measure\"})",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 10,
      "title": "Slowest successful HTTP endpoints — p95 seconds",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "topk(10, max by (endpoint) (k6_endpoint_latency_ms_p95{run_id=\"$run_id\",phase=\"measure\"}))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 11,
      "title": "Dropped scheduled iterations",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum by (scenario) (k6_dropped_iterations_total{run_id=\"$run_id\"})",
          "legendFormat": "{{scenario}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    }
  ]
}
